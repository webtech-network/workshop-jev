# Configuracao do Replit. O botao Run executa a verificacao do ambiente,
# que NAO chama a API (a chave e compartilhada pela turma).
#
# Esta e uma conveniencia: o caminho documentado do workshop e digitar os
# comandos no painel Shell, que funciona independente deste arquivo. Se o
# Replit reconfigurar o Run ao importar o repositorio, use o Shell.
#
# A chave da API vai em Tools -> Secrets, com o nome AI_GATEWAY_API_KEY.
# NAO crie um .env.local no Replit: Secrets nao entra em forks nem no
# historico do Git, e um arquivo entra.
#
# De proposito NAO declaramos 'modules' aqui. O formato do nome do modulo
# Python do Replit e versionado (a doc mostra "python-3.10:v18-20230807-...")
# e muda com o tempo; um nome errado quebra o ambiente na importacao. O
# importador do Replit detecta Python sozinho. Se o Shell disser
# "python3: command not found", adicione Python pelo painel de dependencias
# do Replit em vez de editar este arquivo.

run = "python3 verificar.py"
entrypoint = "README.md"

hidden = [".config", ".cache", ".upm", ".pythonlibs", "__pycache__"]
